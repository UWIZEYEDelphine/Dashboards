<th>MTD</th>
<th>PMTD</th>
<th>MTD_CHANGE</th>
</tr>';

WITH Revenue AS (
	SELECT 
        'Total Revenue' AS KPI,
        FORMAT(Total_revenue_today, '#,##0') AS TODAY,
        FORMAT(Total_revenue_prev, '#,##0') AS PREVIOUS_DAY,
        FORMAT(ISNULL(((Total_revenue_today - Total_revenue_prev) * 100.0 / NULLIF(Total_revenue_prev, 0)), 0), '#,##0.00') + '%' AS Change,	
        FORMAT(MTD_revenue, '#,##0') AS MTD,
        FORMAT(PMTD_revenue, '#,##0') AS PMTD,
        FORMAT(ISNULL(((MTD_revenue - PMTD_revenue) * 100.0 / NULLIF(PMTD_revenue, 0)), 0), '#,##0.00') + '%' AS MTD_Change
    FROM OPENQUERY(EVA, '
WITH base AS (

    /* Total Revenue from DSL Customer Subject */
    SELECT
        c.tbl_dt,
        TRY_CAST(c.tot_rev AS DOUBLE) AS transactionamount
    FROM hive.bsl.dslcustomersubject c
    JOIN hive.analytics.phone_deal_202604 d
        ON c.msisdn_key = d.msisdn
    WHERE c.tbl_dt BETWEEN
          CAST(date_format(date_add(''month'', -1, date_trunc(''month'', current_date)), ''%Y%m%d'') AS INTEGER)
          AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
    UNION ALL
    /* Negative PAM Adjustments */
    SELECT
        sdp.tbl_dt,
        -(TRY_CAST(sdp.pam_amount_enrich AS DOUBLE)) AS transactionamount
    FROM hive.feeds.sdp_cdr sdp
    JOIN hive.analytics.phone_deal_202604 d
        ON sdp.msisdn_key = d.msisdn
    WHERE sdp.tbl_dt BETWEEN
          CAST(date_format(date_add(''month'', -1, date_trunc(''month'', current_date)), ''%Y%m%d'') AS INTEGER)
          AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
      AND sdp.cdrtypemain = ''PAM''
      AND sdp.transaction_type_enrich = -1
)
SELECT

    /* Yesterday */
    SUM(
        CASE
            WHEN tbl_dt = CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS Total_revenue_today,
    /* Previous Day */
    SUM(
        CASE
            WHEN tbl_dt = CAST(date_format(date_add(''day'', -2, current_date), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS Total_revenue_prev,
    /* Current Month To Date */
    SUM(
        CASE
            WHEN tbl_dt BETWEEN
                 CAST(date_format(date_trunc(''month'', date_add(''day'', -1, current_date)), ''%Y%m%d'') AS INTEGER)
                 AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS MTD_Revenue,
    /* Previous Month To Date */
    SUM(
        CASE
            WHEN tbl_dt BETWEEN
                 CAST(date_format(date_add(''month'', -1, date_trunc(''month'', date_add(''day'', -1, current_date))), ''%Y%m%d'') AS INTEGER)
                 AND CAST(date_format(date_add(''month'', -1, date_add(''day'', -1, current_date)), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS PMTD_Revenue
FROM base

') AS SubQuery

UNION ALL

SELECT 
    'Voice_Revenue',
    FORMAT(Voice_Revenue_today, '#,##0'),
    FORMAT(Voice_Revenue_prev, '#,##0'),
    FORMAT(ISNULL(((Voice_Revenue_today - Voice_Revenue_prev) * 100.0 / NULLIF(Voice_Revenue_prev, 0)), 0), '#,##0.00') + '%' AS Change,
	FORMAT(MTD_revenue, '#,##0') AS MTD,
    FORMAT(PMTD_revenue, '#,##0') AS PMTD,
    FORMAT(ISNULL(((MTD_revenue - PMTD_revenue) * 100.0 / NULLIF(PMTD_revenue, 0)), 0), '#,##0.00') + '%' AS MTD_Change
FROM (
    SELECT 
        sum(rev_voice_int+rev_voice_offnet+rev_voice_onnet+rev_voice_pack+rev_voice_roam_incoming+rev_voice_roam_outgoing) AS Voice_Revenue_today,
        (SELECT sum(rev_voice_int+rev_voice_offnet+rev_voice_onnet+rev_voice_pack+rev_voice_roam_incoming+rev_voice_roam_outgoing) FROM [dbo].[ebu_phone_deal_revenue] WHERE CONVERT(DATE, CAST(Date_key AS VARCHAR(8)), 112) = CONVERT(DATE, GETDATE() - 2)) AS Voice_Revenue_prev,
		(select SUM(rev_voice_int+rev_voice_offnet+rev_voice_onnet+rev_voice_pack+rev_voice_roam_incoming+rev_voice_roam_outgoing) FROM [dbo].[ebu_phone_deal_revenue]
			WHERE Date_key BETWEEN FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMM01') AND FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMMdd')) AS MTD_revenue,
            (SELECT SUM(rev_voice_int+rev_voice_offnet+rev_voice_onnet+rev_voice_pack+rev_voice_roam_incoming+rev_voice_roam_outgoing) FROM [dbo].[ebu_phone_deal_revenue] 
             WHERE Date_key BETWEEN FORMAT(DATEADD(MONTH, -1, DATEADD(DAY, -1, GETDATE())), 'yyyyMM01') 
             AND FORMAT(DATEADD(MONTH, -1, DATEADD(DAY, -1, GETDATE())), 'yyyyMMdd')) AS PMTD_revenue
    FROM [dbo].[ebu_phone_deal_revenue]
    WHERE CONVERT(DATE, CAST(Date_key AS VARCHAR(8)), 112) = CONVERT(DATE, GETDATE() - 1)
) AS SubQuery

UNION ALL

SELECT 
    'Data_Revenue',
    FORMAT(Data_Revenue_today, '#,##0'),
    FORMAT(Data_Revenue_prev, '#,##0'),
    FORMAT(ISNULL(((Data_Revenue_today - Data_Revenue_prev) * 100.0 / NULLIF(Data_Revenue_prev, 0)), 0), '#,##0.00') + '%' AS Change,	
	FORMAT(MTD_revenue, '#,##0') AS MTD,
    FORMAT(PMTD_revenue, '#,##0') AS PMTD,
    FORMAT(ISNULL(((MTD_revenue - PMTD_revenue) * 100.0 / NULLIF(PMTD_revenue, 0)), 0), '#,##0.00') + '%' AS MTD_Change
FROM OPENQUERY(EVA, '
WITH base AS (
    /* SDP Revenue */
    SELECT
        sdp.tbl_dt,
        -(TRY_CAST(sdp.pam_amount_enrich AS DOUBLE)) AS transactionamount
    FROM hive.feeds.sdp_cdr sdp
    JOIN hive.analytics.phone_deal_202604 d
        ON sdp.msisdn_key = d.msisdn
    WHERE sdp.tbl_dt BETWEEN
          CAST(date_format(date_add(''month'', -1, date_trunc(''month'', current_date)), ''%Y%m%d'') AS INTEGER)
          AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
      AND sdp.cdrtypemain = ''PAM''
      AND (sdp.transaction_type_enrich = 5 OR sdp.transaction_type_enrich = -1)
    UNION ALL
    /* PAYG + Roaming Revenue */
    SELECT
        c.tbl_dt,
        (TRY_CAST(c.rev_data_payg AS DOUBLE) + TRY_CAST(c.rev_data_roaming AS DOUBLE)) AS transactionamount
    FROM hive.bsl.dslcustomersubject c
    JOIN hive.analytics.phone_deal_202604 d
        ON c.msisdn_key = d.msisdn
    WHERE c.tbl_dt BETWEEN
          CAST(date_format(date_add(''month'', -1, date_trunc(''month'', current_date)), ''%Y%m%d'') AS INTEGER)
          AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
)
SELECT
    /* Yesterday */
    SUM(
        CASE
            WHEN tbl_dt = CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS Data_Revenue_today,

    /* Previous Day */
    SUM(
        CASE
            WHEN tbl_dt = CAST(date_format(date_add(''day'', -2, current_date), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS Data_Revenue_prev,
    /* Current MTD */
    SUM(
        CASE
            WHEN tbl_dt BETWEEN
                 CAST(date_format(date_trunc(''month'', date_add(''day'', -1, current_date)), ''%Y%m%d'') AS INTEGER)
                 AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS MTD_Revenue,
    /* Previous Month To Date */
    SUM(
        CASE
            WHEN tbl_dt BETWEEN
                 CAST(date_format(date_add(''month'', -1, date_trunc(''month'', date_add(''day'', -1, current_date))), ''%Y%m%d'') AS INTEGER)
                 AND CAST(date_format(date_add(''month'', -1, date_add(''day'', -1, current_date)), ''%Y%m%d'') AS INTEGER)
            THEN transactionamount ELSE 0
        END
    ) AS PMTD_Revenue
FROM base
') AS SubQuery

UNION ALL

SELECT 
    'SMS_Revenue',
    FORMAT(SMS_Revenue_today, '#,##0'),
    FORMAT(SMS_Revenue_prev, '#,##0'),
    FORMAT(ISNULL(((SMS_Revenue_today - SMS_Revenue_prev) * 100.0 / NULLIF(SMS_Revenue_prev, 0)), 0), '#,##0.00') + '%' AS Change,
	FORMAT(MTD_revenue, '#,##0') AS MTD,
    FORMAT(PMTD_revenue, '#,##0') AS PMTD,
    FORMAT(ISNULL(((MTD_revenue - PMTD_revenue) * 100.0 / NULLIF(PMTD_revenue, 0)), 0), '#,##0.00') + '%' AS MTD_Change
FROM (
    SELECT 
        sum(rev_sms_int+rev_sms_offnet+rev_sms_onnet+rev_sms_roaming) AS SMS_Revenue_today,
        (SELECT sum(rev_sms_int+rev_sms_offnet+rev_sms_onnet+rev_sms_roaming) FROM [dbo].[ebu_phone_deal_revenue] WHERE CONVERT(DATE, CAST(Date_key AS VARCHAR(8)), 112) = CONVERT(DATE, GETDATE() - 2)) AS SMS_Revenue_prev,
		(select SUM(rev_sms_int+rev_sms_offnet+rev_sms_onnet+rev_sms_roaming) FROM [dbo].[ebu_phone_deal_revenue]
		WHERE Date_key BETWEEN FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMM01') AND FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMMdd')) AS MTD_revenue,
        (SELECT SUM(rev_sms_int+rev_sms_offnet+rev_sms_onnet+rev_sms_roaming) FROM [dbo].[ebu_phone_deal_revenue] 
         WHERE Date_key BETWEEN FORMAT(DATEADD(MONTH, -1, DATEADD(DAY, -1, GETDATE())), 'yyyyMM01') 
         AND FORMAT(DATEADD(MONTH, -1, DATEADD(DAY, -1, GETDATE())), 'yyyyMMdd')) AS PMTD_revenue
    FROM [dbo].[ebu_phone_deal_revenue]
    WHERE CONVERT(DATE, CAST(Date_key AS VARCHAR(8)), 112) = CONVERT(DATE, GETDATE() - 1)
) AS SubQuery

UNION ALL

SELECT 
    'VAS_Revenue',
    FORMAT(VAS_Revenue_today, '#,##0'),
    FORMAT(VAS_Revenue_prev, '#,##0'),
    FORMAT(ISNULL(((VAS_Revenue_today - VAS_Revenue_prev) * 100.0 / NULLIF(VAS_Revenue_prev, 0)), 0), '#,##0.00') + '%' AS Change,
	FORMAT(MTD_revenue, '#,##0') AS MTD,
        FORMAT(PMTD_revenue, '#,##0') AS PMTD,
        FORMAT(ISNULL(((MTD_revenue - PMTD_revenue) * 100.0 / NULLIF(PMTD_revenue, 0)), 0), '#,##0.00') + '%' AS MTD_Change
FROM (
    SELECT 
        sum(rev_VAS1+rev_VAS2+rev_VAS3+rev_VAS4+rev_other_VAS) AS VAS_Revenue_today,
        (SELECT sum(rev_VAS1+rev_VAS2+rev_VAS3+rev_VAS4+rev_other_VAS) FROM [dbo].[ebu_phone_deal_revenue] WHERE CONVERT(DATE, CAST(Date_key AS VARCHAR(8)), 112) = CONVERT(DATE, GETDATE() - 2)) AS VAS_Revenue_prev,
		(select SUM(rev_VAS1+rev_VAS2+rev_VAS3+rev_VAS4+rev_other_VAS) FROM [dbo].[ebu_phone_deal_revenue]
		WHERE Date_key BETWEEN FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMM01') AND FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMMdd')) AS MTD_revenue,
        (SELECT SUM(rev_VAS1+rev_VAS2+rev_VAS3+rev_VAS4+rev_other_VAS) FROM [dbo].[ebu_phone_deal_revenue] 
         WHERE Date_key BETWEEN FORMAT(DATEADD(MONTH, -1, DATEADD(DAY, -1, GETDATE())), 'yyyyMM01') 
         AND FORMAT(DATEADD(MONTH, -1, DATEADD(DAY, -1, GETDATE())), 'yyyyMMdd')) AS PMTD_revenue
    FROM [dbo].[ebu_phone_deal_revenue]
    WHERE CONVERT(DATE, CAST(Date_key AS VARCHAR(8)), 112) = CONVERT(DATE, GETDATE() - 1)
) AS SubQuery
UNION ALL
SELECT 
    'MOMO_Revenue',
    FORMAT(MOMO_Revenue_today, '#,##0'),
    FORMAT(MOMO_Revenue_prev, '#,##0'),
    FORMAT(ISNULL(((MOMO_Revenue_today - MOMO_Revenue_prev) * 100.0 / NULLIF(MOMO_Revenue_prev, 0)), 0), '#,##0.00') + '%' AS Change,
	FORMAT(MTD_revenue, '#,##0') AS MTD,
        FORMAT(PMTD_revenue, '#,##0') AS PMTD,
        FORMAT(ISNULL(((MTD_revenue - PMTD_revenue) * 100.0 / NULLIF(PMTD_revenue, 0)), 0), '#,##0.00') + '%' AS MTD_Change
FROM OPENQUERY(EVA, '
WITH base AS (
    SELECT
        a.tbl_dt,
        TRY_CAST(a.amount AS DOUBLE) AS amount
    FROM hive.feeds.momo_transactions a
    LEFT JOIN hive.feeds.sdp_cdr b
        ON a.financial_transaction_id = b.origtransactionid
       AND a.tbl_dt = b.tbl_dt
    JOIN hive.analytics.phone_deal_202604 d
        ON a.msisdn_key = d.msisdn
    WHERE a.tbl_dt BETWEEN
          CAST(date_format(date_add(''month'', -1, date_trunc(''month'', current_date)), ''%Y%m%d'') AS INTEGER)
          AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
      AND UPPER(a.to_username) LIKE ''%BUNDLES.SP%''
      AND a.transaction_status = ''COMMITTED''
      AND b.pam_id IS NOT NULL
      AND b.pam_id <> ''''
    UNION ALL
    SELECT
        a.tbl_dt,
        TRY_CAST(a.amount AS DOUBLE) AS amount
    FROM hive.feeds.momo_transactions a
    LEFT JOIN hive.feeds.sdp_cdr b
        ON a.external_transaction_id = b.origtransactionid
       AND a.tbl_dt = b.tbl_dt
   JOIN hive.analytics.phone_deal_202604 d
        ON a.msisdn_key = d.msisdn
    WHERE a.tbl_dt BETWEEN
          CAST(date_format(date_add(''month'', -1, date_trunc(''month'', current_date)), ''%Y%m%d'') AS INTEGER)
          AND CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
      AND (
            UPPER(a.to_username) LIKE ''%PRESTIGE%''
         OR UPPER(a.to_username) LIKE ''%DATABUNDLE.MTN%''
         OR UPPER(a.to_username) LIKE ''%DATABUNDLES.MTN%''
         OR UPPER(a.to_username) LIKE ''%YOLOBUNDLES.MTN%''
         OR UPPER(a.to_username) LIKE ''%VOICE%''
      )
      AND UPPER(a.from_profile) LIKE ''%SUBS%''
      AND a.transaction_status = ''COMMITTED''
      AND b.pam_id IS NOT NULL
      AND b.pam_id <> ''''
)
SELECT
    SUM(
        CASE
            WHEN tbl_dt = CAST(date_format(date_add(''day'', -1, current_date), ''%Y%m%d'') AS INTEGER)
            THEN amount ELSE 0
        END
    ) AS MOMO_Revenue_today,
    SUM(
        CASE
            WHEN tbl_dt = CAST(date_format(date_add(''day'', -2, current_date), ''%Y%m%d'') AS INTEGER)
            THEN amount ELSE 0
        END
