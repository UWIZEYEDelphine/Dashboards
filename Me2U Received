select distinct msisdn_key as MSISDN,sum(cast(b.transaction_amt as double)) as MeUReceived
from hive.feeds.air_refill_ma
where msisdn_key=250780304762
and tbl_dt between 20240301 and 20240326
order by tbl_dt


